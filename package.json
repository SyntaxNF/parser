{
  "name": "snf-parser",
  "version": "0.2.2",
  "description": "A parser for SNF (Simple Normal Form) grammar",
  "type": "module",
  "author": "baskwind <baskwind@163.com>",
  "license": "MIT",
  "homepage": "https://github.com/SimpleNF/parser",
  "repository": "https://github.com/SimpleNF/parser",
  "keywords": [
    "snf",
    "parser"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/esm/index.mjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/type/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/type/index.d.ts",
      "import": "./dist/esm/index.mjs"
    }
  },
  "scripts": {
    "test": "tsx test/index.ts && tsx test/uid.ts && tsx test/boundary-identity.ts && tsx test/name.ts && tsx test/metadata.ts && tsx test/normalize.ts && tsx test/compiler.ts && tsx test/indentation.ts && tsx test/simple.ts",
    "test:simple": "tsx test/simple.ts",
    "test:indent": "tsx test/indentation.ts",
    "test:name": "tsx test/name.ts",
    "test:uid": "tsx test/uid.ts && tsx test/boundary-identity.ts",
    "test:complex": "tsx test/complex.ts",
    "build": "node scripts/clean-build.mjs && vite build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript/typescript6": "^6.0.2",
    "glob": "^13.0.6",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  }
}
